# OmniRouter API Configuration Example
# Copy this file to .env if you wish to set environment defaults (optional).
# The desktop app also allows configuring these directly in the UI Settings modal.

# Base URL for the OpenAI-compatible OmniRouter endpoint
OMNIROUTER_BASE_URL=https://api.omnirouter.ai/v1

# Your OmniRouter API key (do NOT commit real keys to version control!)
OMNIROUTER_API_KEY=your_api_key_here

# Default model ID
OMNIROUTER_DEFAULT_MODEL=anthropic/claude-3.7-sonnet
